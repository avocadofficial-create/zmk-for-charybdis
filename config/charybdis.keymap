#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    macros {
        To1_macro: To1_macro {
            compatible = "zmk,behavior-macro";
            label = "To1_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(128,100,50) &to 1>;
        };

        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>;
        };

        To2_macro: To2_macro {
            compatible = "zmk,behavior-macro";
            label = "To2_macro";
            #binding-cells = <0>;
            bindings =
                <&to 2>,
                <&macro_wait_time 30>,
                <&rgb_ug RGB_COLOR_HSB(250,100,50)>;
        };

        screenshift: screenshift {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI &kp LEFT_SHIFT>,
                <&macro_tap>,
                <&kp RIGHT_ARROW>,
                <&macro_release>,
                <&kp LEFT_GUI &kp LEFT_SHIFT>;

            label = "SCREENSHIFT";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp N1          &kp N2  &kp N3  &kp N4     &kp N5     &kp N6          &kp N7          &kp N8     &kp N9     &kp N0   &kp BSPC  &kp MINUS
&kp TAB         &kp Q   &kp W   &kp E      &kp R      &kp T           &kp Y           &kp U      &kp I      &kp O    &kp P     &kp DELETE
&kp LEFT_SHIFT  &kp A   &kp S   &kp D      &kp F      &kp G           &kp H           &kp J      &kp K      &kp L    &kp SEMI  &kp ENTER
&kp LCTRL       &kp Z   &kp X   &kp C      &kp V      &kp B           &kp N           &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp SQT
                                &mkp LCLK  &mkp RCLK  &mo 3           &kp LANGUAGE_1  &kp SPACE
                                           &mo 1      &screenshift    &mo 1
            >;
        };

        F_layers {
            bindings = <
&kp F1     &kp F2  &kp F3  &kp F4           &kp F5        &kp F6          &kp F7          &kp F8           &kp F9           &kp F10    &kp F11           &kp F12
&kp TILDE  &none   &none   &none            &none         &trans          &none           &none            &none            &none      &none             &none
&trans     &none   &none   &kp PRINTSCREEN  &kp LEFT_GUI  &kp LEFT_ALT    &none           &kp UP_ARROW     &none            &none      &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&trans     &trans  &trans  &kp ESCAPE       &kp F8        &kp F2          &kp LEFT_ARROW  &kp DOWN_ARROW   &kp RIGHT_ARROW  &kp MINUS  &kp UNDER         &kp EQUAL
                           &trans           &trans        &To0_macro      &none           &kp PRINTSCREEN
                                            &trans        &trans          &trans
            >;
        };

        BT_layers {
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans          &trans          &trans          &trans     &trans                &trans
&trans  &trans          &trans        &trans        &trans        &trans          &trans          &trans          &trans          &trans     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&trans  &bt BT_CLR_ALL  &trans        &trans        &trans        &trans          &trans          &kp UP_ARROW    &trans          &trans     &kp LEFT_BRACKET      &kp RIGHT_BRACKET
&trans  &trans          &trans        &bt BT_CLR    &trans        &trans          &kp LEFT_ARROW  &kp DOWN_ARROW  &kp DOWN_ARROW  &kp MINUS  &kp UNDER             &kp EQUAL
                                      &trans        &trans        &trans          &trans          &trans
                                                    &trans        &trans          &trans
            >;
        };

        scroll-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &mkp LCLK  &mkp RCLK  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &mkp LCLK  &mkp RCLK
                                &trans  &trans    &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };
    };
};
